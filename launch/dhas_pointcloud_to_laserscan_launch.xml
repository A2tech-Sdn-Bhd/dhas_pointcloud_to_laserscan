<launch>


  <!-- PointCloud to LaserScan -->
  <node
    pkg="pointcloud_to_laserscan"
    exec="pointcloud_to_laserscan_node"
    name="pointcloud_to_laserscan">

     <remap from="cloud_in" to="patchworkpp/nonground"/> <!--/velodyne_points -->
    <remap from="scan" to="laser/scan"/>


    <param name="queue_size" value="10"/>
    <param name="target_frame" value="laserscan"/>
    <param name="transform_tolerance" value="0.01"/>  <!-- changed from 0.01-->
    <param name="min_height" value="0.0"/>
    <param name="max_height" value="10.0"/>
    <param name="angle_min" value="-3.14159"/>
    <param name="angle_max" value="3.14159"/>
    <param name="angle_increment" value="0.0087"/>
    <param name="scan_time" value="0.3333"/>
    <param name="range_min" value="0.80"/>
    <param name="range_max" value="60.0"/>
    <param name="use_inf" value="false"/>
    <param name="inf_epsilon" value="1.0"/>

  </node>

</launch>
